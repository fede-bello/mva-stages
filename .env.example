# Copy to .env.local (gitignored) and fill in. `vercel env pull .env.local` fills the
# frontend vars (and server-only ones from the Supabase integration) automatically.

# Frontend (exposed to the browser by Vite; both are public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Maintenance scripts (pull_remote.py, load_remote.py) work without it through the
# logged-in Supabase CLI (`supabase login` + `supabase link`). Set it only to use psql directly: session pooler URL
# with the percent-encoded password and ?sslmode=require. Secret: never commit, never VITE_.
SUPABASE_DB_URL=
